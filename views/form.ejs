<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= task && task.id ? 'Editar tarea' : 'Nueva tarea' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <span class="brand">TaskFlow</span>
    <a href="/tasks">Volver</a>
  </nav>

  <main class="narrow">
    <h1><%= task && task.id ? 'Editar tarea' : 'Nueva tarea' %></h1>

    <% if (errors.length > 0) { %>
      <div class="alert alert-error">
        <ul>
          <% errors.forEach(err => { %>
            <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form
      action="<%= task && task.id ? '/tasks/' + task.id + '?_method=PUT' : '/tasks' %>"
      method="POST">

      <label>Título</label>
      <input type="text" name="title" value="<%= task ? task.title : '' %>" required>

      <label>Descripción</label>
      <textarea name="description" required><%= task ? task.description : '' %></textarea>

      <label>Fecha límite</label>
      <input type="date" name="dueDate" value="<%= task ? task.dueDate : '' %>" required>

      <label>Estado</label>
      <select name="status">
        <option value="pendiente" <%= task && task.status === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
        <option value="completada" <%= task && task.status === 'completada' ? 'selected' : '' %>>Completada</option>
      </select>

      <button class="btn btn-primary" type="submit">Guardar</button>
    </form>
  </main>
</body>
</html>
